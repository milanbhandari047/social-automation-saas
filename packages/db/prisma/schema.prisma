generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================
 * ENUMS
 * =========================
 */

enum Platform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
  PARTIAL
}

/**
 * =========================
 * USER
 * =========================
 */

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  workspaces Workspace[]
}

/**
 * =========================
 * WORKSPACE
 * =========================
 */

model Workspace {
  id        String   @id @default(cuid())
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * OWNER
   */
  ownerId String
  owner   User @relation(fields: [ownerId], references: [id])

  /**
   * RELATIONS
   */
  socialAccounts SocialAccount[]
  posts          Post[]
}

/**
 * =========================
 * CONNECTED SOCIAL ACCOUNTS
 * =========================
 */

model SocialAccount {
  id String @id @default(cuid())

  /**
   * FACEBOOK / INSTAGRAM / TIKTOK
   */
  platform Platform

  /**
   * TOKENS
   */
  accessToken  String
  refreshToken String?

  /**
   * PLATFORM ACCOUNT INFO
   */
  accountId   String  @unique
  accountName String?

  username     String?
  profileImage String?

  /**
   * FLEXIBLE JSON DATA
   * followers, category, page info, etc.
   */
  metadata Json?

  createdAt DateTime @default(now())

  /**
   * WORKSPACE RELATION
   */
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /**
   * RELATIONS
   */
  postTargets PostTarget[]
}

/**
 * =========================
 * POSTS
 * =========================
 */

model Post {
  id String @id @default(cuid())
  

  /**
   * CONTENT
   */
  content  String
  mediaUrl String?

  /**
   * STATUS
   */
  status PostStatus @default(DRAFT)

  /**
   * SCHEDULING
   */
  scheduledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?
  failedAt DateTime?

  /**
   * WORKSPACE RELATION
   */
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /**
   * RELATIONS
   */
  targets PostTarget[]
}

/**
 * =========================
 * POST TARGETS
 * ONE POST -> MANY PLATFORMS
 * =========================
 */

model PostTarget {
  id String @id @default(cuid())

  /**
   * PUBLISH STATUS
   */
  status PostStatus @default(DRAFT)

  /**
   * PLATFORM RESPONSE DATA
   */
  platformPostId String?
  publishedUrl   String?

  /**
   * ERROR HANDLING
   */
  errorMessage String?

  /**
   * TIMESTAMPS
   */
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  retryCount Int @default(0)


  /**
   * POST RELATION
   */
  postId String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  /**
   * SOCIAL ACCOUNT RELATION
   */
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}